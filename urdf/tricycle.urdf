<?xml version="1.0" ?>
<!--
  Tricycle Robot URDF
  ===================
  3-wheeled robot with:
    - 1 steerable rear wheel  (revolute joint around vertical z-axis)
    - 2 fixed-direction front wheels  (continuous joints around lateral y-axis)
    - Front wheels are driven; rear wheel is steering-only

  Dimensions:
    Chassis  : 0.50 m (x, forward) × 0.40 m (y, lateral) × 0.12 m (z, up), 10 kg
    Wheelbase: 0.40 m  (front-axle x=+0.20 m, rear-axle x=-0.20 m from body centre)
    Front track: 0.40 m (left wheel y=+0.20 m, right wheel y=-0.20 m)
    Wheel    : radius 0.10 m, width 0.05 m, 1 kg each

  Coordinate frame (base_link origin = chassis centre):
    x → forward, y → left, z → up

  At launch the base_link origin is placed at z = 0.25 m so that wheel
  centres (at joint z-offset -0.15 m) sit at z = 0.10 m and the wheel
  bottoms (radius 0.10 m) just touch the ground plane (z = 0).
-->
<robot name="tricycle">

  <!-- ======================== MATERIALS ======================== -->
  <material name="chassis_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="fork_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ======================== BASE LINK (Chassis) ======================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.4 0.12"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.4 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <!-- Box moments: Ixx=m(w²+h²)/12, Iyy=m(l²+h²)/12, Izz=m(l²+w²)/12 -->
      <!-- l=0.5, w=0.4, h=0.12, m=10 -->
      <inertia ixx="0.1453" ixy="0.0" ixz="0.0"
                             iyy="0.2203" iyz="0.0"
                                           izz="0.3417"/>
    </inertial>
  </link>

  <!-- ======================== REAR STEERING FORK ========================= -->
  <!-- Acts as the steering pivot between the chassis and the rear wheel.   -->
  <link name="rear_steer_link">
    <visual>
      <!-- Vertical post representing the steering column -->
      <geometry>
        <cylinder radius="0.015" length="0.08"/>
      </geometry>
      <material name="fork_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <!-- Small vertical cylinder: Ixx=Izz≈m(3r²+h²)/12, Iyy=mr²/2 -->
      <!-- r=0.015, h=0.08 -->
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0"
                             iyy="0.0001" iyz="0.0"
                                           izz="0.0028"/>
    </inertial>
  </link>

  <!--
    Rear steering joint: REVOLUTE around the vertical z-axis.
    This is the only joint that steers — the rear wheel turns left/right.
    Located at the rear axle position at wheel-centre height.
    Limits: ±45° (±0.7854 rad)
  -->
  <joint name="rear_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_steer_link"/>
    <origin xyz="-0.2 0.0 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="100.0" velocity="10.0"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- ======================== REAR WHEEL ========================= -->
  <!--
    The rear wheel rotates (rolls) freely around the lateral y-axis.
    Steering is applied to the parent rear_steer_link; the wheel itself
    only rolls — it does NOT drive the robot.
    Visual/collision cylinder is rotated 90° around x to align with y-axis.
  -->
  <link name="rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <!-- Rotate cylinder so its axis aligns with y (lateral / spin axis) -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Cylinder axis along y: Iyy=mr²/2, Ixx=Izz=m(3r²+h²)/12 -->
      <!-- r=0.1, h=0.05, m=1 -->
      <inertia ixx="0.00271" ixy="0.0" ixz="0.0"
                              iyy="0.00500" iyz="0.0"
                                             izz="0.00271"/>
    </inertial>
  </link>

  <!-- Front wheel rolling joint: CONTINUOUS around lateral y-axis (free rolling) -->
  <joint name="rear_wheel_joint" type="continuous">
    <parent link="rear_steer_link"/>
    <child link="rear_wheel"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- ======================== FRONT LEFT WHEEL ======================= -->
  <!--
    Driven wheel — velocity control applied in simulation.
    Fixed lateral direction (no steering degree of freedom).
  -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00271" ixy="0.0" ixz="0.0"
                              iyy="0.00500" iyz="0.0"
                                             izz="0.00271"/>
    </inertial>
  </link>

  <joint name="front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.2 0.2 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- ======================== FRONT RIGHT WHEEL ====================== -->
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00271" ixy="0.0" ixz="0.0"
                              iyy="0.00500" iyz="0.0"
                                             izz="0.00271"/>
    </inertial>
  </link>

  <joint name="front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.2 -0.2 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

</robot>
